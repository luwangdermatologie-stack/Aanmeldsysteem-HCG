{
  "entities": {
    "patient": {
      "title": "Patient",
      "description": "A checked-in patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "birthDate": { "type": "string" },
        "nationalRegNum": { "type": "string" },
        "idCardNum": { "type": "string" },
        "appointmentTime": { "type": "string" },
        "arrivalTime": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "waitingRoom": { "type": "string" },
        "isLate": { "type": "boolean" },
        "hasAppointment": { "type": "boolean" },
        "isNoShow": { "type": "boolean" },
        "noShowReason": { "type": "string", "nullable": true },
        "completed": { "type": "boolean" },
        "helpRequested": { "type": "boolean", "nullable": true },
        "helpDescription": { "type": "string", "nullable": true },
        "notes": { "type": "string", "nullable": true },
        "date": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "arrivalTime", "hasAppointment", "completed", "date"]
    },
    "doctor": {
      "title": "Doctor",
      "description": "Practicing doctor or nurse profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "waitingRoom": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "avatarColor": { "type": "string" }
      },
      "required": ["id", "name", "specialty", "waitingRoom", "isAvailable", "avatarColor"]
    },
    "activeStaff": {
      "title": "ActiveStaff",
      "description": "Front desk staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "isPresent": { "type": "boolean" },
        "lastActive": { "type": "string" }
      },
      "required": ["id", "name", "role", "isPresent", "lastActive"]
    },
    "systemConfig": {
      "title": "SystemConfig",
      "description": "App settings and integrations",
      "type": "object",
      "properties": {
        "teamsWebhookUrl": { "type": "string" },
        "notifyOnCheckin": { "type": "boolean" },
        "notifyOnLate": { "type": "boolean" },
        "notifyOnNoAppointment": { "type": "boolean" },
        "notifyOnHelp": { "type": "boolean" },
        "kioskAutoResetSeconds": { "type": "number" },
        "adminPin": { "type": "string" }
      },
      "required": ["adminPin"]
    },
    "teamsNotification": {
      "title": "TeamsNotification",
      "description": "Logged notification message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "targetDoctor": { "type": "string" },
        "targetStaff": { "type": "string" },
        "payload": { "type": "object" },
        "status": { "type": "string" },
        "messagePreview": { "type": "string" }
      },
      "required": ["id", "timestamp", "status", "messagePreview"]
    },
    "timesheet": {
      "title": "Timesheet",
      "description": "Staff clock in and out records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "clockIn": { "type": "string" },
        "clockOut": { "type": "string", "nullable": true },
        "date": { "type": "string" }
      },
      "required": ["id", "staffId", "staffName", "clockIn", "date"]
    }
  },
  "firestore": {
    "patients": {
      "schema": "patient",
      "description": "Live and archived patients collection"
    },
    "doctors": {
      "schema": "doctor",
      "description": "Dermatologists setup"
    },
    "staff": {
      "schema": "activeStaff",
      "description": "Reception staff setup"
    },
    "config": {
      "schema": "systemConfig",
      "description": "Active system settings document"
    },
    "notifications": {
      "schema": "teamsNotification",
      "description": "Audit trail of Teams notifications sent"
    },
    "timesheets": {
      "schema": "timesheet",
      "description": "Staff clock-in/out records"
    }
  }
}
