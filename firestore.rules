rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Patients checkin data
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // Doctors & Rooms configuration
    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    // Staff presence configuration
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // System Settings & Webhook Config
    match /config/{configId} {
      allow read, write: if true;
    }

    // Teams Notifications log
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Staff Clock-in / Clock-out Timesheets
    match /timesheets/{timesheetId} {
      allow read, write: if true;
    }

    // Archived Patients
    match /archived_patients/{archiveId} {
      allow read, write: if true;
    }

    // Leave Planning - Staff Members
    match /leave_staff/{staffId} {
      allow read, write: if true;
    }

    // Leave Planning - Leave Requests
    match /leave_requests/{requestId} {
      allow read, write: if true;
    }

    // Leave Planning - General Comments per week
    match /leave_comments/{commentId} {
      allow read, write: if true;
    }

    // Leave Planning - Coordinator Todos & Archive
    match /leave_todos/{todoId} {
      allow read, write: if true;
    }

    // Leave Planning - Config (Google Sheets settings, etc.)
    match /leave_config/{configId} {
      allow read, write: if true;
    }

    // ========================================================
    // TEST ENVIRONMENT COLLECTIONS (Google AI Studio Preview)
    // Strictly separated from GitHub Production collections
    // ========================================================
    match /test_patients/{patientId} {
      allow read, write: if true;
    }
    match /test_doctors/{doctorId} {
      allow read, write: if true;
    }
    match /test_staff/{staffId} {
      allow read, write: if true;
    }
    match /test_config/{configId} {
      allow read, write: if true;
    }
    match /test_notifications/{notificationId} {
      allow read, write: if true;
    }
    match /test_timesheets/{timesheetId} {
      allow read, write: if true;
    }
    match /test_archived_patients/{archiveId} {
      allow read, write: if true;
    }
    match /test_leave_staff/{staffId} {
      allow read, write: if true;
    }
    match /test_leave_requests/{requestId} {
      allow read, write: if true;
    }
    match /test_leave_comments/{commentId} {
      allow read, write: if true;
    }
    match /test_leave_todos/{todoId} {
      allow read, write: if true;
    }
    match /test_leave_config/{configId} {
      allow read, write: if true;
    }
  }
}
