rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all safety filter: deny any unexpected collection
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for schema validation
    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Patients collection - used by Reception Kiosk (registration) and Staff Dashboard
    match /patients/{patientId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Doctors collection - clinic medical team roster & room assignments
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if true;
    }

    // Staff collection - clinic support team & status
    match /staff/{staffId} {
      allow read: if true;
      allow write: if true;
    }

    // Config collection - operational settings (dagdeel, active staff, webhook)
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // MS Teams Notifications audit trail
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Staff timesheets - clock-in / clock-out tracking
    match /timesheets/{timesheetId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Leave Planning - Staff Members
    match /leave_staff/{staffId} {
      allow read, write: if true;
    }
