rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all safety filter
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to validate basic ID string shapes
    function isValidId(id) { 
      return id is string && id.size() <= 128; 
    }

    // Patients collection - Kiosk needs to register, Admin needs to manage
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // Doctors collection
    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    // Staff collection
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Config collection - single config doc
    match /config/{configId} {
      allow read, write: if true;
    }

    // MS Teams Notifications audit trail
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Staff timesheets
    match /timesheets/{timesheetId} {
      allow read, write: if true;
    }
  }
}
